@* Botón de marca. Se renderiza como <a> si recibe Href; si no, como <button>. *@
@if (Href is not null && !IsDisabled)
{
    <a href="@Href" class="@CssClass" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
        @Content
    </a>
}
else
{
    <button type="@Type" class="@CssClass" disabled="@IsDisabled" aria-busy="@(Loading ? "true" : null)"
            aria-label="@AriaLabel" @onclick="HandleClick" @attributes="AdditionalAttributes">
        @Content
    </button>
}

@code {
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public string? IconStart { get; set; }
    [Parameter] public string? IconEnd { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsDisabled => Disabled || Loading;

    private string CssClass => string.Join(' ', new[]
    {
        "btn",
        Variant == "primary" ? null : $"btn--{Variant}",
        Size == "md" ? null : $"btn--{Size}",
        Block ? "btn--block" : null,
        IconOnly ? "btn--icon" : null,
        Class
    }.Where(c => c is not null));

    private RenderFragment Content => __builder =>
    {
        if (Loading)
        {
            <span class="btn__spinner" aria-hidden="true"></span>
            @if (!IconOnly)
            {
                <span>@(LoadingText ?? "Procesando…")</span>
            }
        }
        else
        {
            @if (IconStart is not null)
            {
                <Icon Name="@IconStart" />
            }
            @ChildContent
            @if (IconEnd is not null)
            {
                <Icon Name="@IconEnd" />
            }
        }
    };

    private Task HandleClick(MouseEventArgs e) => OnClick.HasDelegate ? OnClick.InvokeAsync(e) : Task.CompletedTask;
}
