@page "/cuenta/contrasena"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@* Estático: tras cambiar la contraseña se renueva la cookie (RefreshSignInAsync requiere HttpContext). *@
<SeoHead Title="Cambiar contraseña" Description="Actualiza la contraseña de tu cuenta." NoIndex="true" />

<div class="page-hero">
    <div class="container">
        <Breadcrumbs Items="@([new("Mi cuenta", "/cuenta/perfil"), new("Contraseña")])" />
        <h1 tabindex="-1">Contraseña</h1>
        <p class="lead">Usa una contraseña única que no utilices en otros sitios.</p>
    </div>
</div>

<div class="container account-layout">
    <AccountNav />
    <section class="card card--pad" style="max-width:560px" aria-labelledby="pwd-title">
        <h2 id="pwd-title" style="font-size:var(--fs-xl)">Cambiar contraseña</h2>
        @if (_success)
        {
            <div class="notice notice--success" role="status" style="margin-bottom:var(--space-5)">
                <Icon Name="check-circle" /><span>Tu contraseña se actualizó correctamente.</span>
            </div>
        }
        @if (_errors.Count > 0)
        {
            <div class="notice notice--danger" role="alert" style="margin-bottom:var(--space-5)">
                <Icon Name="alert" />
                <div>@foreach (var e in _errors) { <span style="display:block">@e</span> }</div>
            </div>
        }
        <EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <div class="field">
                    <label class="field__label" for="pwd-current">Contraseña actual</label>
                    <InputText id="pwd-current" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
                    <ValidationMessage For="() => Input.CurrentPassword" />
                </div>
                <div class="field">
                    <label class="field__label" for="pwd-new">Nueva contraseña</label>
                    <InputText id="pwd-new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
                    <span class="field__hint">Mínimo 8 caracteres, con una mayúscula, una minúscula y un número.</span>
                    <ValidationMessage For="() => Input.NewPassword" />
                </div>
                <div class="field">
                    <label class="field__label" for="pwd-confirm">Repite la nueva contraseña</label>
                    <InputText id="pwd-confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
                <div><AppButton Type="submit" IconStart="lock">Actualizar contraseña</AppButton></div>
            </div>
        </EditForm>
    </section>
</div>

@code {
    private readonly List<string> _errors = [];
    private bool _success;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordInput Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            _errors.Add("No pudimos cargar tu cuenta. Vuelve a ingresar.");
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        _success = true;
        Input = new();
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Ingresa tu contraseña actual.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la nueva contraseña.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Debe tener al menos 8 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
